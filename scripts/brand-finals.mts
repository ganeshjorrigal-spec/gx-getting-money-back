import {readFileSync,writeFileSync,mkdirSync} from 'node:fs';
import sharp from 'sharp';
mkdirSync('public/images',{recursive:true});
const loop=readFileSync('public/images/refund-genie-loop.svg');
const icons:Buffer[]=[];
for(const size of [16,32,180,512]){const png=await sharp(loop).resize(size,size).png().toBuffer();writeFileSync(`public/images/icon-${size}.png`,png);if(size<40)icons.push(png);}
// ICO container with PNG16/32 entries. Same authored loop, no new model image.
const header=Buffer.alloc(6+16*icons.length);header.writeUInt16LE(1,2);header.writeUInt16LE(icons.length,4);let offset=header.length;
icons.forEach((bytes,i)=>{const start=6+i*16,size=i===0?16:32;header[start]=size;header[start+1]=size;header.writeUInt16LE(1,start+4);header.writeUInt16LE(32,start+6);header.writeUInt32LE(bytes.length,start+8);header.writeUInt32LE(offset,start+12);offset+=bytes.length;});writeFileSync('public/favicon.ico',Buffer.concat([header,...icons]));
writeFileSync('public/manifest.webmanifest',JSON.stringify({name:'Refund Genie',short_name:'Refund Genie',start_url:'/',display:'standalone',background_color:'#f7f6f1',theme_color:'#14213d',icons:[{src:'/images/icon-180.png',sizes:'180x180',type:'image/png',purpose:'any'},{src:'/images/icon-512.png',sizes:'512x512',type:'image/png',purpose:'any'}]},null,2)+'\n');
if(readFileSync('public/images/mascot.webp').length>=60000)throw new Error('Mascot budget');
const meta=await sharp('public/images/mascot.webp').metadata();if(!meta.hasAlpha)throw new Error('Mascot must preserve transparency');
// Selected final head: smooth scalp, ears and face, excluding the receipt below it.
await sharp('public/images/mascot.webp').extract({left:235,top:45,width:155,height:155}).resize(64,64).webp({quality:85}).toFile('public/images/mascot-head.webp');
const sizes=[16,32,48,64,180,512];
const root='../../../public/images/';
writeFileSync('docs/design/finals/index.html',`<!doctype html><html lang="en"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>D-047 finals review</title><style>@font-face{font-family:Fraunces;src:url(../logo-candidates/fraunces-latin.woff2);font-weight:500 700;font-display:swap}body{background:#f7f6f1;color:#14213d;font:16px system-ui;margin:24px}h1,h2,.wordmark{font-family:Fraunces,serif}.grid{display:flex;flex-wrap:wrap;gap:24px;align-items:start}.card{background:white;border:1px solid #d8d1c7;padding:16px;max-width:560px}.wordmark{font-weight:700;font-size:24px}.row{display:flex;align-items:center;gap:12px;flex-wrap:wrap}img{max-width:100%;height:auto}.transparent{background:#fde7c4}</style><h1>D-047 finals · for review</h1><p>Ganesh's approved SmokeLogo2 traced by hand, simplified loop icon, Mascot6 and four approved scenes. High-quality API edits. Unpublished. Original drafts retained.</p><div class="grid">${sizes.map(size=>`<section class="card"><h2>${size}px</h2><p>Full mark and loop icon</p><div class="row"><img src="${root}refund-genie-mark.svg" width="${size}" alt="Full smoke receipt mark"/><img src="${root}refund-genie-loop.svg" width="${size}" alt="Loop-only icon"/></div><div class="row"><img src="${root}refund-genie-mark.svg" width="${Math.min(size,64)}" alt=""/><span class="wordmark">Refund Genie</span></div>${[16,32,180,512].includes(size)?`<p>Exported PNG</p><img src="${root}icon-${size}.png" width="${size}" alt="${size}px app icon"/>`:''}</section>`).join('')}</div><h2>Mascot6 final and64px head</h2><div class="row transparent"><img src="${root}mascot.webp" width="280" alt="Genie presenting a receipt"/><img src="${root}mascot-head.webp" width="64" height="64" alt="Genie head"/></div><h2>Scenes</h2><div class="grid">${['airport','on-hold','refund-coming','family'].map(name=>`<section class="card"><h3>${name}</h3><img src="${root}${name}.webp" width="320" alt="${name} illustration"/></section>`).join('')}</div><p>Model requests37/40 including one rejected mascot correction; icons and crop consume no model calls. Fonts and official company files unchanged.</p></html>`);
console.log('Brand icons, manifest, crop and review written. No image API calls.');
