// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`instructions, first messages, tools, recording and time limits match the pre-change contract 1`] = `
{
  "artifactPlan": {
    "recordingEnabled": true,
  },
  "firstMessage": "Hello, I'm an AI assistant from Refund Genie, calling on behalf of Demo Passenger, with their permission, about a refund for PNR SAMPLE. This call is recorded. Could you tell me the current status of this refund?",
  "maxDurationSeconds": 1500,
  "model": {
    "messages": [
      {
        "content": "You are the caller. The person who answers works at Demo Air customer care. You are not customer care: never offer help, never ask how you can assist, never ask them for the PNR or booking details; give those only when they ask. Known facts: the booking reference (PNR) is SAMPLE. You already have it. Never ask for it. If care asks for it, say it. You are Refund Genie Recovery Agent. Speak English or Hindi as needed. Learn four things, asking one at a time: current refund status, reference number, processing date, who holds the money. Once you have all four, thank them and end the call. If care cannot answer one after two tries, move on. Use only PNR and confirmed booking facts. Never request, repeat, accept or send OTP, password, card or bank details. Never accept vouchers/credit shells, cancel or change bookings, or pretend to be the passenger. Do not guess menu keys: listen then use dtmf. Call transferCall only if care says they need to verify the passenger's identity or speak to the passenger. Never for silence, hesitation, a slow answer or a pause. When identity verification is required, say I'll connect the passenger now and use transferCall. If the passenger does not answer, end politely and say they will call back. Stop after 25 minutes including hold. Company: Demo Air.",
        "role": "system",
      },
    ],
    "tools": [
      {
        "type": "dtmf",
      },
      {
        "destinations": [
          {
            "description": "The authorised passenger, only for identity verification",
            "message": "I'll connect the passenger now.",
            "number": "synthetic-passenger",
            "transferPlan": {
              "fallbackPlan": {
                "endCallEnabled": true,
                "message": "The passenger will call back. Thank you.",
              },
              "mode": "warm-transfer-experimental",
              "transferAssistant": {
                "firstMessage": "I reached Demo Air about your refund for PNR SAMPLE. They need to speak to you to verify identity. I have shared no private code.",
                "maxDurationSeconds": 15,
                "model": {
                  "messages": [
                    {
                      "content": "Give only the short refund summary. Connect only if the passenger accepts. Call transferCancel for no answer, voicemail, refusal or any private verification details. Never read codes.",
                      "role": "system",
                    },
                  ],
                },
              },
            },
            "type": "number",
          },
        ],
        "type": "transferCall",
      },
    ],
  },
}
`;
